#!/bin/bash

strip -s ./depkg

wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage
wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-checkrt/releases/download/continuous/linuxdeploy-plugin-checkrt-x86_64.sh

chmod a+x linuxdeploy-x86_64.AppImage
chmod a+x linuxdeploy-plugin-checkrt-x86_64.sh

./linuxdeploy-x86_64.AppImage --appdir AppDir
./linuxdeploy-plugin-checkrt-x86_64.sh --appdir AppDir

./linuxdeploy-x86_64.AppImage --appdir AppDir -d ../depkg.desktop -e ./depkg -i ../icon.png
./linuxdeploy-x86_64.AppImage --appdir AppDir --output appimage

mv depkg-x86_64.AppImage depkg.AppImage

mkdir -p ./depkg-VERSION-linux
cp ./depkg.AppImage ./depkg-VERSION-linux/
cp ../install_pkg.sh ./depkg-VERSION-linux/
cp ../batch_install.sh ./depkg-VERSION-linux/
cp ../readme_linux.txt ./depkg-VERSION-linux/
